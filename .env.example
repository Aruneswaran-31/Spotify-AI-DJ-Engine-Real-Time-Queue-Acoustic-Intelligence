# Copy to .env and fill in. Never commit .env.
# Required in any shared/deployed environment (a random ephemeral key is used otherwise).
JWT_SECRET=replace-with-a-long-random-string

# Default is backend/app.db. PostgreSQL also works once a driver (e.g. psycopg) is installed:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/aidj
# DATABASE_URL=sqlite:///./app.db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Rolling sentiment window (seconds) and minimum samples before curation reacts.
SENTIMENT_WINDOW_SECONDS=120
SENTIMENT_MIN_SAMPLES=3

# Optional grounded LLM banter (OpenAI-compatible). Without a key the deterministic
# grounded generator is used and every demo still works.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://freebuff.com/api/v1/paid
OPENAI_MODEL=gpt-4o-mini
AI_DJ_USE_LLM=1
